<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- DEBUG BUILDS ONLY. testOnly lets `adb shell dpm remove-active-admin` work. -->
    <application android:testOnly="true" tools:ignore="HardcodedDebugMode">
        <!--
            Developer unlock: undoes everything and removes Device Owner.
            Protected by DUMP, which only the adb shell (and system) holds,
            so normal apps on the phone cannot trigger it.
        -->
        <receiver
            android:name=".dev.DevUnlockReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.appsonly.filter.DEV_UNLOCK" />
            </intent-filter>
        </receiver>
        <!-- Automated emulator test hooks (adb only). -->
        <receiver
            android:name=".dev.DevLockReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver
            android:name=".dev.DevCheckReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver
            android:name=".dev.DevTamperLogReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver
            android:name=".dev.DevStatusReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver
            android:name=".dev.DevLicenseReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
